+# --- CAST ---
+import os as _os
+import numpy as _np
+import torch as _t
+import torch.nn.functional as _F
+_CAST_W1 = float(_os.environ.get('CAST_W1', '0'))
+_CAST_W2 = float(_os.environ.get('CAST_W2', '0'))
+_CAST_TAU = float(_os.environ.get('CAST_TAU', '0.07'))
+_CAST_NOW = _os.environ.get('CAST_NO_WEIGHT', '0') == '1'
+_CAST = {'init': False}
+
+
+def _cast_setup(features_dim, optimizer, device):
+    z = _np.load(_os.path.expandvars('$PROJ/cast/cast_anchors.npz'))
+    _CAST['T_id'] = _t.tensor(z['T_id']).float().to(device)
+    _CAST['T_cl'] = _t.tensor(z['T_cl']).float().to(device)
+    _CAST['W'] = _t.tensor(z['W']).float().to(device)
+    if _CAST_NOW:
+        _CAST['W'] = _t.ones_like(_CAST['W'])
+    proj = _t.nn.Linear(features_dim, _CAST['T_id'].shape[1]).to(device)
+    optimizer.add_param_group({'params': proj.parameters(), 'lr': 3.5e-4})
+    _CAST['proj'] = proj
+    _CAST['init'] = True
+    print('CAST enabled: W1=%s W2=%s tau=%s no_weight=%s' %
+          (_CAST_W1, _CAST_W2, _CAST_TAU, _CAST_NOW))
+
+
+def _cast_loss(features, pids, clothes_ids, optimizer):
+    if not _CAST['init']:
+        _cast_setup(features.shape[1], optimizer, features.device)
+    if int(pids.max()) >= _CAST['T_id'].shape[0]:
+        raise RuntimeError(
+            'CAST v1 anchors are CCVID-specific (T_id has %d identities but saw pid %d). '
+            'Do NOT enable CAST_W1/W2 on other datasets.'
+            % (_CAST['T_id'].shape[0], int(pids.max())))
+    f = _F.normalize(_CAST['proj'](features), dim=-1)
+    logits = f @ _CAST['T_id'].t() / _CAST_TAU
+    ce = _F.cross_entropy(logits, pids, reduction='none')
+    w = _CAST['W'][pids]
+    l_align = (ce * w).sum() / w.sum().clamp(min=1e-6)
+    l_orth = (f * _CAST['T_cl'][clothes_ids]).sum(-1).pow(2).mean()
+    return _CAST_W1 * l_align + _CAST_W2 * l_orth, l_align.item(), l_orth.item()
+
+
